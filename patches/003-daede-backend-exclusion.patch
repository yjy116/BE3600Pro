--- /dev/null
+++ b/luci-app-daede/root/usr/share/luci-app-daede/backend-exec
@@ -0,0 +1,25 @@
+#!/bin/sh
+# Keep one lock descriptor alive through the selected core and guard cleanup.
+backend="$1"
+shift
+case "$backend:$1" in
+	dae:/usr/bin/dae|daed:/usr/bin/daed-guard) ;;
+	*) echo "daede: invalid backend command" >&2; exit 1 ;;
+esac
+[ "$2" = run ] || { echo "daede: expected backend run command" >&2; exit 1; }
+exec 9>/var/lock/daede-backend.lock || exit 1
+if ! flock -n 9; then
+	echo "daede: another backend owns the runtime lock, or locking failed" >&2
+	exit 1
+fi
+active="$(uci -q get daede.config.active_backend)" || {
+	echo "daede: cannot read active backend" >&2; exit 1;
+}
+case "$active" in
+	dae|daed) ;;
+	*) echo "daede: invalid active backend: $active" >&2; exit 1 ;;
+esac
+[ "$active" = "$backend" ] || {
+	echo "daede: active backend is $active; refusing $backend" >&2; exit 1;
+}
+exec "$@"
